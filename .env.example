# Copy to .env and fill in. Never commit .env.

# --- storage -------------------------------------------------------------
# Default: SQLite at data/hunt.db. For cloud/GitHub Actions use PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
# Encrypts phone, address, visa status and EEO fields at rest. Generate: python -m hunt keygen
HUNT_SECRET_KEY=

# --- schedule ------------------------------------------------------------
HUNT_TIMEZONE=America/Chicago
HUNT_SCHEDULE_HOUR=9
HUNT_SCHEDULE_MINUTE=0
HUNT_SCHEDULER_ENABLED=true

# --- submission safety ---------------------------------------------------
# Applications are always prepared; they are only ever sent to real employers when
# this is true AND the dashboard mode/approval allows it.
HUNT_ALLOW_REAL_SUBMISSIONS=false
HUNT_HEADLESS=true

# --- dashboard -----------------------------------------------------------
HUNT_HOST=127.0.0.1
HUNT_PORT=8000
# Required if the dashboard is reachable from other machines:
HUNT_DASHBOARD_PASSWORD=

# --- Claude (optional) ---------------------------------------------------
# Enables fact-guarded bullet rewording, cover letters and open-ended answers.
ANTHROPIC_API_KEY=
HUNT_LLM_MODEL=claude-opus-5-5

# --- Gmail monitoring (optional, read-only IMAP) -------------------------
# Use a Gmail App Password (Google Account > Security > 2-Step Verification > App passwords).
HUNT_IMAP_USER=
HUNT_IMAP_PASSWORD=

# --- notifications (optional) --------------------------------------------
# Daily report + blocked-application alerts are emailed only to HUNT_NOTIFY_EMAIL.
HUNT_SMTP_USER=
HUNT_SMTP_PASSWORD=
HUNT_NOTIFY_EMAIL=
